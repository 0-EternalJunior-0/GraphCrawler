# Include documentation
include README.md
include LICENSE
include CHANGELOG.md

# Include config files
include pyproject.toml
include requirements.txt

# Include type hints marker
include graph_crawler/py.typed

# Include docs
recursive-include docs *.md

# Include native Cython source files (for building from source)
recursive-include graph_crawler/native *.pyx
recursive-include graph_crawler/native *.pxd
include graph_crawler/native/setup.py
include graph_crawler/native/README.md

# Exclude tests from distribution
prune tests
prune .git
prune .github

# Exclude dev files
exclude .gitignore
exclude .pre-commit-config.yaml
exclude Makefile

# Exclude cache and compiled files
global-exclude __pycache__
global-exclude *.py[cod]
global-exclude *.so
global-exclude *.pyd
global-exclude .DS_Store
global-exclude *.c
global-exclude *.html
